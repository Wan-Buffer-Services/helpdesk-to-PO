<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_helpdesk_ticket_form_inherit_po" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.inherit.po</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_purchase_orders" type="object" class="oe_stat_button" icon="fa-credit-card"
                        invisible="po_count == 0">
                    <field name="po_count" widget="statinfo" string="Purchase Orders"/>
                </button>
            </div>
            
            <header position="inside">
                <button name="action_create_purchase_order" string="Create Purchase Order" type="object" class="btn-primary"/>
                <button name="action_link_existing_po" string="Link Existing PO" type="object" class="btn-secondary"/>
            </header>
        </field>
    </record>
</odoo>
